<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Remotes -->
  <remote name="aosp"
          fetch="https://android.googlesource.com/"
          review="android-review.googlesource.com"
          revision="refs/tags/android-15.0.0_r1" />

  <remote name="github"
          fetch="https://github.com/" />

  <!-- Default settings -->
  <default remote="aosp"
           revision="refs/tags/android-15.0.0_r1"
           sync-j="8" />

  <!-- Include the main AOSP manifest or a Treble base -->
  <!-- Option A: If you want a full base manifest, you usually include upstream repos. 
       For a GSI, most people inherit from Phh-Treble / TrebleDroid manifests. 
       Let's add a placeholder for your Treble base or custom additions: -->

  <project path="device/phh/treble" name="phhusson/device_phh_treble" remote="github" revision="android-15.0" />

</manifest>
